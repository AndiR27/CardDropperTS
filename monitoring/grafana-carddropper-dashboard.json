{
  "__inputs": [
    {
      "name": "DS_POSTGRESQL",
      "label": "PostgreSQL",
      "description": "CardDropper PostgreSQL datasource",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "__elements": {},
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-postgresql-datasource",
      "name": "PostgreSQL",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "barchart",
      "name": "Bar chart",
      "version": ""
    },
    {
      "type": "panel",
      "id": "piechart",
      "name": "Pie chart",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    }
  ],
  "id": null,
  "uid": "carddropper-stats",
  "title": "CardDropper - Game Stats",
  "description": "Statistiques de jeu CardDropper",
  "tags": ["carddropper", "game", "postgresql"],
  "style": "dark",
  "timezone": "Europe/Zurich",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Top 10 Collectionneurs",
      "description": "Joueurs avec le plus de cartes (total copies)",
      "type": "barchart",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRESQL}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "Cartes",
            "fillOpacity": 80,
            "gradientMode": "scheme",
            "lineWidth": 1,
            "scaleDistribution": { "type": "linear" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#6ED0E0", "value": 10 },
              { "color": "yellow", "value": 30 },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "barRadius": 0.2,
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "legend": { "displayMode": "hidden" },
        "orientation": "horizontal",
        "tooltip": { "mode": "single", "sort": "none" },
        "xTickLabelRotation": 0,
        "showValue": "always",
        "colorByField": "total_cards"
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRESQL}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT u.username, SUM(uc.quantity) AS total_cards\nFROM user_cards uc\nJOIN ts_user u ON u.id = uc.user_id\nGROUP BY u.username\nORDER BY total_cards DESC\nLIMIT 10;",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Distribution par Raret\u00e9",
      "description": "Nombre de cartes actives par raret\u00e9",
      "type": "piechart",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRESQL}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed" },
          "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "COMMON" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#8B98A5", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "RARE" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#3B82F6", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "EPIC" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#A855F7", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "LEGENDARY" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#F0B232", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "tooltip": { "mode": "single", "sort": "none" },
        "displayLabels": ["name", "value"]
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRESQL}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT c.rarity, COUNT(*) AS count\nFROM card c\nWHERE c.active = true\nGROUP BY c.rarity\nORDER BY CASE c.rarity\n  WHEN 'COMMON' THEN 1\n  WHEN 'RARE' THEN 2\n  WHEN 'EPIC' THEN 3\n  WHEN 'LEGENDARY' THEN 4\nEND;",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              { "fieldName": "rarity", "handlerKey": "field.name" },
              { "fieldName": "count", "handlerKey": "field.value" }
            ]
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Activit\u00e9 — \u00c9v\u00e9nements par Jour",
      "description": "Nombre d'\u00e9v\u00e9nements (drops, trades, uses...) par jour sur les 30 derniers jours",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 10 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRESQL}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "",
            "drawStyle": "bars",
            "fillOpacity": 60,
            "gradientMode": "scheme",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRESQL}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  date_trunc('day', created_at) AS time,\n  event_type,\n  COUNT(*) AS events\nFROM live_feed_event\nWHERE created_at >= NOW() - INTERVAL '30 days'\nGROUP BY date_trunc('day', created_at), event_type\nORDER BY time;",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "prepareTimeSeries",
          "options": { "format": "multi" }
        }
      ]
    },
    {
      "id": 4,
      "title": "Cartes les plus Rares",
      "description": "Cartes actives les moins poss\u00e9d\u00e9es",
      "type": "table",
      "gridPos": { "h": 11, "w": 14, "x": 0, "y": 20 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRESQL}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "name" },
            "properties": [
              { "id": "displayName", "value": "Carte" },
              { "id": "custom.width", "value": 200 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "rarity" },
            "properties": [
              { "id": "displayName", "value": "Raret\u00e9" },
              { "id": "custom.width", "value": 120 },
              { "id": "mappings", "value": [
                { "type": "value", "options": { "COMMON": { "text": "Commune", "color": "#8B98A5" }, "RARE": { "text": "Rare", "color": "#3B82F6" }, "EPIC": { "text": "\u00c9pique", "color": "#A855F7" }, "LEGENDARY": { "text": "L\u00e9gendaire", "color": "#F0B232" } } }
              ]}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "total_owned" },
            "properties": [
              { "id": "displayName", "value": "Total Copies" },
              { "id": "custom.width", "value": 110 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "unique_owners" },
            "properties": [
              { "id": "displayName", "value": "Propri\u00e9taires" },
              { "id": "custom.width", "value": 120 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "is_unique" },
            "properties": [
              { "id": "displayName", "value": "Unique" },
              { "id": "custom.width", "value": 80 },
              { "id": "mappings", "value": [
                { "type": "value", "options": { "true": { "text": "\u2b50" }, "false": { "text": "" } } }
              ]}
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false },
        "sortBy": [{ "displayName": "Total Copies", "desc": false }]
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRESQL}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  c.name,\n  c.rarity,\n  COALESCE(SUM(uc.quantity), 0) AS total_owned,\n  COUNT(DISTINCT uc.user_id) AS unique_owners,\n  c.is_unique\nFROM card c\nLEFT JOIN user_cards uc ON uc.card_id = c.id\nWHERE c.active = true\nGROUP BY c.id, c.name, c.rarity, c.is_unique\nORDER BY total_owned ASC, c.rarity DESC\nLIMIT 15;",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Dodge Leaderboard — Cette Semaine",
      "description": "Meilleurs scores du mini-jeu Dodge cette semaine",
      "type": "table",
      "gridPos": { "h": 11, "w": 10, "x": 14, "y": 20 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRESQL}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "rank" },
            "properties": [
              { "id": "displayName", "value": "#" },
              { "id": "custom.width", "value": 50 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "username" },
            "properties": [
              { "id": "displayName", "value": "Joueur" },
              { "id": "custom.width", "value": 160 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "best_score" },
            "properties": [
              { "id": "displayName", "value": "Meilleur Score" },
              { "id": "custom.width", "value": 130 },
              { "id": "thresholds", "value": {
                "mode": "absolute",
                "steps": [
                  { "color": "text", "value": null },
                  { "color": "yellow", "value": 50 },
                  { "color": "orange", "value": 100 },
                  { "color": "red", "value": 200 }
                ]
              }},
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false },
        "sortBy": [{ "displayName": "Meilleur Score", "desc": true }]
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRESQL}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  ROW_NUMBER() OVER (ORDER BY ds.best_score DESC) AS rank,\n  u.username,\n  ds.best_score\nFROM dodge_score ds\nJOIN ts_user u ON u.id = ds.user_id\nWHERE ds.week_start = date_trunc('week', CURRENT_DATE)::date\nORDER BY ds.best_score DESC\nLIMIT 10;",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Drop Rates — Toutes Ouvertures de Packs",
      "description": "Pourcentage de drops par raret\u00e9 sur l'ensemble des ouvertures de packs",
      "type": "piechart",
      "gridPos": { "h": 10, "w": 8, "x": 0, "y": 31 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRESQL}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "COMMON" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#8B98A5", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "RARE" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#3B82F6", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "EPIC" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#A855F7", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "LEGENDARY" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#F0B232", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "tooltip": { "mode": "single", "sort": "none" },
        "displayLabels": ["name", "percent"]
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRESQL}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT card_rarity, COUNT(*) AS drops\nFROM live_feed_event\nWHERE event_type = 'PACK_OPEN'\nGROUP BY card_rarity\nORDER BY CASE card_rarity\n  WHEN 'COMMON' THEN 1\n  WHEN 'RARE' THEN 2\n  WHEN 'EPIC' THEN 3\n  WHEN 'LEGENDARY' THEN 4\nEND;",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              { "fieldName": "card_rarity", "handlerKey": "field.name" },
              { "fieldName": "drops", "handlerKey": "field.value" }
            ]
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Drop Rates par Joueur",
      "description": "R\u00e9partition des raret\u00e9s obtenues par joueur (en %)",
      "type": "barchart",
      "gridPos": { "h": 10, "w": 16, "x": 8, "y": 31 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRESQL}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "%",
            "fillOpacity": 80,
            "gradientMode": "none",
            "lineWidth": 1,
            "scaleDistribution": { "type": "linear" },
            "stacking": { "group": "A", "mode": "percent" }
          },
          "max": 100,
          "unit": "percent"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "COMMON" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#8B98A5", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "RARE" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#3B82F6", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "EPIC" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#A855F7", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "LEGENDARY" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#F0B232", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "barRadius": 0.1,
        "barWidth": 0.75,
        "groupWidth": 0.7,
        "legend": { "displayMode": "list", "placement": "bottom" },
        "orientation": "vertical",
        "tooltip": { "mode": "multi", "sort": "desc" },
        "xTickLabelRotation": -45,
        "showValue": "never",
        "stacking": "percent"
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRESQL}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  actor_username AS player,\n  SUM(CASE WHEN card_rarity = 'COMMON' THEN 1 ELSE 0 END) AS \"COMMON\",\n  SUM(CASE WHEN card_rarity = 'RARE' THEN 1 ELSE 0 END) AS \"RARE\",\n  SUM(CASE WHEN card_rarity = 'EPIC' THEN 1 ELSE 0 END) AS \"EPIC\",\n  SUM(CASE WHEN card_rarity = 'LEGENDARY' THEN 1 ELSE 0 END) AS \"LEGENDARY\"\nFROM live_feed_event\nWHERE event_type = 'PACK_OPEN'\nGROUP BY actor_username\nORDER BY SUM(1) DESC\nLIMIT 15;",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Chanceux vs Malchanceux — Taux d'\u00c9piques+L\u00e9gendaires",
      "description": "Joueurs class\u00e9s par % de drops \u00c9piques et L\u00e9gendaires (min. 10 ouvertures)",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 41 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRESQL}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "player" },
            "properties": [
              { "id": "displayName", "value": "Joueur" },
              { "id": "custom.width", "value": 160 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "total_drops" },
            "properties": [
              { "id": "displayName", "value": "Total Drops" },
              { "id": "custom.width", "value": 110 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "common_pct" },
            "properties": [
              { "id": "displayName", "value": "% Commune" },
              { "id": "custom.width", "value": 100 },
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 1 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "rare_pct" },
            "properties": [
              { "id": "displayName", "value": "% Rare" },
              { "id": "custom.width", "value": 100 },
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 1 },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "thresholds", "value": {
                "mode": "absolute",
                "steps": [
                  { "color": "text", "value": null },
                  { "color": "#3B82F6", "value": 15 }
                ]
              }}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "epic_pct" },
            "properties": [
              { "id": "displayName", "value": "% \u00c9pique" },
              { "id": "custom.width", "value": 100 },
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 1 },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "thresholds", "value": {
                "mode": "absolute",
                "steps": [
                  { "color": "text", "value": null },
                  { "color": "#A855F7", "value": 5 }
                ]
              }}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "legendary_pct" },
            "properties": [
              { "id": "displayName", "value": "% L\u00e9gendaire" },
              { "id": "custom.width", "value": 120 },
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 1 },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "thresholds", "value": {
                "mode": "absolute",
                "steps": [
                  { "color": "text", "value": null },
                  { "color": "#F0B232", "value": 1 }
                ]
              }}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "luck_score" },
            "properties": [
              { "id": "displayName", "value": "Score Chance" },
              { "id": "custom.width", "value": 120 },
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 1 },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "thresholds", "value": {
                "mode": "absolute",
                "steps": [
                  { "color": "red", "value": null },
                  { "color": "orange", "value": 5 },
                  { "color": "yellow", "value": 10 },
                  { "color": "green", "value": 15 },
                  { "color": "#A855F7", "value": 25 }
                ]
              }}
            ]
          }
        ]
      },
      "options": {
