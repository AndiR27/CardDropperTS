          "rawSql": "SELECT\n  actor_username AS player,\n  COUNT(*) AS total_drops,\n  ROUND(100.0 * SUM(CASE WHEN card_rarity = 'COMMON' THEN 1 ELSE 0 END) / COUNT(*), 1) AS common_pct,\n  ROUND(100.0 * SUM(CASE WHEN card_rarity = 'RARE' THEN 1 ELSE 0 END) / COUNT(*), 1) AS rare_pct,\n  ROUND(100.0 * SUM(CASE WHEN card_rarity = 'EPIC' THEN 1 ELSE 0 END) / COUNT(*), 1) AS epic_pct,\n  ROUND(100.0 * SUM(CASE WHEN card_rarity = 'LEGENDARY' THEN 1 ELSE 0 END) / COUNT(*), 1) AS legendary_pct,\n  ROUND(100.0 * SUM(CASE WHEN card_rarity IN ('EPIC', 'LEGENDARY') THEN 1 ELSE 0 END) / COUNT(*), 1) AS luck_score\nFROM live_feed_event\nWHERE event_type = 'PACK_OPEN'\nGROUP BY actor_username\nHAVING COUNT(*) >= 10\nORDER BY luck_score DESC;",
